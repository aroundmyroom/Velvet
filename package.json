{
  "name": "velvet",
  "version": "0.4.25",
  "description": "Velvet — your personal music server",
  "type": "module",
  "main": "cli-boot-wrapper.js",
  "bin": {
    "velvet": "cli-boot-wrapper.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node cli-boot-wrapper.js",
    "wizard": "npm install --only=prod && node cli-boot-wrapper.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sync-version": "node scripts/sync-webapp-version.cjs",
    "build:tizen": "node scripts/build-tizen-wgt.cjs",
    "build:tizen:dist": "node scripts/build-tizen-wgt.cjs --dist",
    "release": "node scripts/release.cjs",
    "version": "node scripts/sync-webapp-version.cjs && git add -A",
    "test": "node --test test/integration/*.test.cjs test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aroundmyroom/Velvet"
  },
  "author": "AroundMyRoom",
  "homepage": "",
  "license": "GPL-3.0",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@lvcabral/node-ssdp": "^4.0.4",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "busboy": "^1.6.0",
    "commander": "^15.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "escape-string-regexp": "^5.0.0",
    "essentia.js": "^0.1.3",
    "express": "^5.0.1",
    "fast-xml-parser": "5.11.1",
    "file-type": "22.0.2",
    "helmet": "^8.3.0",
    "http-proxy": "^1.18.1",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "m3u8-parser": "^7.2.0",
    "make-dir": "^5.0.0",
    "mime-types": "^3.0.2",
    "music-metadata": "11.15.0",
    "nanoid": "^6.0.1",
    "sharp": "^0.35.4",
    "tree-kill": "^1.2.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "10.9.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "17.11.0"
  },
  "overrides": {
    "qs": "6.15.2"
  }
}
